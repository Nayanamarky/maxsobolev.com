---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Filters from '../components/Filters.astro';
import Tile from '../components/Tile.astro';
import ToTop from '../components/ToTop.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order
);
---

<Base locale={locale} path="/">
  <Header locale={locale} path="/" />
  <Filters locale={locale} />

  <main class="grid">
    {
      projects.map((p) => (
        <Tile
          locale={locale}
          id={p.id}
          title={p.data.title}
          client={p.data.client}
          year={p.data.year}
          categories={p.data.categories}
          production={p.data.production}
          cover={p.data.cover}
        />
      ))
    }
  </main>

  <footer class="mono">{t('footer')}</footer>
  <ToTop locale={locale} />
</Base>
