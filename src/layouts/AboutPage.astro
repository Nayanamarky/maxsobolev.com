---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import ToTop from '../components/ToTop.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const path = '/about';
const isRu = locale === 'ru';

const media = 'https://maxsobolev-media.b-cdn.net/_site';
const clients = [
  { name: 'Сбер', file: 'sbericon.svg' },
  { name: 'Т-Банк', file: 'tbank.png' },
  { name: 'Avito', file: 'avito.png' },
  { name: 'Альфа-Банк', file: 'alfabankicon.png' },
  { name: 'X5', file: 'x5.png' },
  { name: 'VK', file: 'vkicon.svg' },
  { name: 'Яндекс', file: 'Yandex_icon.svg.png' },
  { name: 'Burger King', file: 'burgerking.svg' },
  { name: 'Vodafone', file: 'vodafone.svg' },
  { name: 'Zalando', file: 'zalando.png' },
  { name: 'М.Видео', file: 'mvideo.svg' },
  { name: 'Лига Ставок', file: 'ligastavok.svg' },
  { name: 'Чистая Линия', file: 'chistayaliniya.svg' },
  { name: 'Черкизово', file: 'cherkizovo.png' },
  { name: 'Curtis', file: 'curtis.svg' },
  { name: 'Добрый', file: 'dobryy.png' },
  { name: 'Земма', file: 'zemma.png' },
];
---

<Base locale={locale} path={path} title={t('menu.about')}>
  <Header locale={locale} path={path} />

  <article class="proj">
    <img
      class="portrait"
      src="https://maxsobolev-media.b-cdn.net/_site/portfolio_01.jpg"
      alt={isRu ? 'Максим Соболев' : 'Max Sobolev'}
    />
    <h1>{t('menu.about')}</h1>
    <div class="projmeta mono">{isRu ? 'CG / VFX PRODUCTION SUPERVISOR · МОСКВА' : 'CG / VFX PRODUCTION SUPERVISOR · MOSCOW'}</div>

    <div class="body">
      {isRu ? (
        <>
          <p>
            В графике — около 14 лет, из них больше семи — супервайзинг: веду проект от брифа заказчика до
            финальной сдачи вместе с продюсером и арт-директором. Выпустил больше 40 рекламных проектов —
            full CG, комбинированные съёмки — для Сбера, Т-Банка, Avito, Mitsubishi, Vodafone, Burger King и
            других российских и зарубежных клиентов.
          </p>
          <p>
            Закрываю супервайзерские задачи, арт-дирекшн и продюсирование — веду проект целиком, а не
            отдельные куски по ходу. Строю план работ и пайплайн под конкретный проект, подбираю команду и
            тайминги вместе с продюсером, ставлю и разбираю задачи с каждым исполнителем — от лейаута и
            моделинга до шейдинга, рендера и композа. Команды — от 10 человек на рекламном ролике до 25+ на
            полном метре или сериале; для крупных проектов пайплайн строил с нуля, с автоматизацией на
            скриптах.
          </p>

          <h2>Опыт</h2>
          <ul>
            <li>Synticate — супервайзер продакшена, арт-дирекшн · реклама / персонажка — 2021–2025</li>
            <li>Союзмультфильм — тех.директор / супервайзер · многосерийный мультсериал — 2020–2021</li>
            <li>Argunov Studio — супервайзер моделинга, CG-генералист · кино — 2019</li>
            <li>NAOS — 3D-артист · мультимедиа — 2017–2019</li>
          </ul>

          <h2>Инструменты</h2>
          <p>
            Maya, After Effects, Houdini, Substance Painter, Arnold, Redshift, весь пакет Adobe —
            супервайзинг в Cerebro, Telegram, Google Sheets, Gantt; полное понимание Nuke, Substance
            Designer, C4D, Zbrush, Marvelous.
          </p>

          <p>
            <a href="https://maxsobolev-media.b-cdn.net/_site/_Соболев Максим Эдуардович_супервайзер_01.doc" download>
              Скачать полное резюме →
            </a>
          </p>
        </>
      ) : (
        <>
          <p>
            About 14 years in the industry, more than seven of them in supervising — running the project
            from client brief to final delivery together with a producer and art director. I've shipped
            40+ ad campaigns — full CG, combined shoot-based work — for Sber, T-Bank, Avito, Mitsubishi,
            Vodafone, Burger King and other clients, Russian and international.
          </p>
          <p>
            I cover supervising, art direction, and producing — running the project whole, not just
            pieces of it. I build the plan and pipeline for each project, pick the team and timing with a
            producer, set and break down tasks with every performer — from layout and modeling to
            shading, rendering, and compositing. Teams range from 10 people on an ad spot to 25+ on a
            feature or series; for bigger projects I've built the pipeline from scratch, with scripted
            automation.
          </p>

          <h2>Experience</h2>
          <ul>
            <li>Synticate — production supervisor, art direction · advertising / character — 2021–2025</li>
            <li>Soyuzmultfilm — technical director / supervisor · animated series — 2020–2021</li>
            <li>Argunov Studio — modeling supervisor, CG generalist · film — 2019</li>
            <li>NAOS — 3D artist · multimedia — 2017–2019</li>
          </ul>

          <h2>Tools</h2>
          <p>
            Maya, After Effects, Houdini, Substance Painter, Arnold, Redshift, the full Adobe suite —
            supervising via Cerebro, Telegram, Google Sheets, Gantt; working knowledge of Nuke, Substance
            Designer, C4D, Zbrush, Marvelous.
          </p>

          <p>
            <a href="https://maxsobolev-media.b-cdn.net/_site/_Соболев Максим Эдуардович_супервайзер_01.doc" download>
              Download full resume →
            </a>
          </p>
        </>
      )}

      <div class="clients">
        {clients.map((c) => (
          <img src={`${media}/${c.file}`} alt={c.name} title={c.name} loading="lazy" />
        ))}
      </div>
    </div>
  </article>

  <footer class="mono">{t('footer')}</footer>
  <ToTop locale={locale} />
</Base>
