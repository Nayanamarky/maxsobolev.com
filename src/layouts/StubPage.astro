---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import ToTop from '../components/ToTop.astro';
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: 'contact' | 'posts';
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const title = t(`menu.${page}` as UIKey);
const path = `/${page}`;

// Страницы «Обо мне», «Контакты», «Посты» ждут контента — см. «Задачи разработки/02_состояние.md».
const stub = locale === 'ru' ? 'Раздел в работе.' : 'Section in progress.';
---

<Base locale={locale} path={path} title={title}>
  <Header locale={locale} path={path} />

  <article class="proj">
    <h1>{title}</h1>
    <p class="stub">{stub}</p>
  </article>

  <footer class="mono">{t('footer')}</footer>
  <ToTop locale={locale} />
</Base>
