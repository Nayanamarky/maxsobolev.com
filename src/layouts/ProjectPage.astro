---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import ToTop from '../components/ToTop.astro';
import ScrubPlayer from '../components/ScrubPlayer.astro';
import { useTranslations, localePath, type Locale, type UIKey } from '../i18n/ui';

interface Neighbour {
  id: string;
  title: string;
}

interface Video {
  label?: { ru: string; en: string };
  embed: string;
  poster?: string;
}

interface Props {
  locale: Locale;
  id: string;
  title: string;
  client: string;
  year: number;
  categories: string[];
  production?: 'shoot' | 'cg';
  role?: { ru: string; en: string };
  cover: string;
  videos?: Video[];
  prev: Neighbour | null;
  next: Neighbour | null;
}

const { locale, id, title, client, year, categories, production, role, cover, videos, prev, next } =
  Astro.props;
const t = useTranslations(locale);
const path = `/project/${id}`;
const productionLabel = production ? t(`production.${production}` as UIKey) : null;

const [heroVideo, ...restVideos] = videos ?? [];
---

<Base locale={locale} path={path} title={`${title} — ${client}`}>
  <Header locale={locale} path={path} />

  <ScrubPlayer size="hero" poster={heroVideo?.poster ?? cover} embed={heroVideo?.embed} />

  <article class="proj">
    <h1>{title}</h1>
    <div class="projmeta mono">
      {client} · {year} · {categories.join(' · ')}
      {productionLabel && <> · <span class="prod">{productionLabel}</span></>}
    </div>
    {role && <div class="projrole">{role[locale]}</div>}

    <div class="body">
      <slot />
    </div>
  </article>

  {
    restVideos.length > 0 && (
      <div class="videolist">
        <h2 class="mono">{t('project.moreVideos')}</h2>
        {restVideos.map((v) => (
          <ScrubPlayer size="clip" poster={v.poster ?? cover} embed={v.embed} label={v.label?.[locale]} />
        ))}
      </div>
    )
  }

  <nav class="prevnext mono">
    {
      prev ? (
        <a href={localePath(locale, `/project/${prev.id}`)}>← {prev.title}</a>
      ) : (
        <span />
      )
    }
    {next && <a href={localePath(locale, `/project/${next.id}`)}>{next.title} →</a>}
  </nav>

  <footer class="mono">{t('footer')}</footer>
  <ToTop locale={locale} />
</Base>
