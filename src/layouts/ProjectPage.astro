---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import ToTop from '../components/ToTop.astro';
import VideoHero from '../components/VideoHero.astro';
import { useTranslations, localePath, type Locale, type UIKey } from '../i18n/ui';

interface Neighbour {
  id: string;
  client: string;
}

interface Video {
  label?: { ru: string; en: string };
  embed: string;
  poster?: string;
}

interface Props {
  locale: Locale;
  id: string;
  title: string;
  client: string;
  year?: number;
  categories: string[];
  cover: string;
  videos?: Video[];
  prev: Neighbour | null;
  next: Neighbour | null;
}

const { locale, id, title, client, year, categories, cover, videos, prev, next } = Astro.props;
const t = useTranslations(locale);
const path = `/project/${id}`;
const home = localePath(locale, '/');
---

<Base locale={locale} path={path} title={`${client} — ${title}`}>
  <Header locale={locale} path={path} />

  <VideoHero locale={locale} videos={videos} cover={cover} />

  <article class="proj">
    <h1>{client}</h1>
    <div class="projmeta mono">
      {title}
      {year && <> · {year}</>}
      {
        categories.map((cat) => (
          <>
            {' · '}
            <a class="tag" href={`${home}?f=${cat}`}>
              {t(`filter.${cat}` as UIKey)}
            </a>
          </>
        ))
      }
    </div>
    <div class="body">
      <slot />
    </div>
  </article>

  <nav class="prevnext mono">
    {
      prev ? (
        <a href={localePath(locale, `/project/${prev.id}`)}>← {prev.client}</a>
      ) : (
        <span />
      )
    }
    {next && <a href={localePath(locale, `/project/${next.id}`)}>{next.client} →</a>}
  </nav>

  <footer class="mono">{t('footer')}</footer>
  <ToTop locale={locale} />
</Base>
