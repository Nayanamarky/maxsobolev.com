---
import { useTranslations, localePath, type Locale, type UIKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  id: string;
  title: string;
  client: string;
  year: number;
  categories: string[];
  production?: 'shoot' | 'cg';
  cover: string;
  index: number;
  total: number;
}

const { locale, id, title, client, year, categories, production, cover, index, total } = Astro.props;
const t = useTranslations(locale);
const idx = String(index).padStart(2, '0');
const totalStr = String(total).padStart(2, '0');
const productionLabel = production ? t(`production.${production}` as UIKey) : null;
---

<a class="tile" href={localePath(locale, `/project/${id}`)} data-cat={categories.join(' ')} data-prod={production ?? ''}>
  <div class="frame" style={`background-image:url('${cover}')`}></div>
  <div class="veil"></div>
  <div class="idx mono">{idx} / {totalStr}</div>
  <div class="meta">
    <div class="title">{title}</div>
    <div class="sub mono">
      {client} · {year}
      {productionLabel && <> · <span class="prod">{productionLabel}</span></>}
    </div>
  </div>
  <div class="scrubwrap">
    <div class="bar"></div>
    <div class="tc mono">00:00:00</div>
  </div>
</a>

<script>
  // Скраб: курсор панорамирует по кадру, полоса и таймкод — оба от позиции курсора
  // по горизонтали, не от времени наведения. Условная длина «клипа» — 60 секунд по 24 fps,
  // просто чтобы было что показывать в формате таймкода.
  const FPS = 24;
  const NOMINAL_SECONDS = 60;

  document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
    const frame = tile.querySelector<HTMLElement>('.frame');
    const bar = tile.querySelector<HTMLElement>('.bar');
    const tc = tile.querySelector<HTMLElement>('.tc');
    if (!frame || !bar || !tc) return;

    tile.addEventListener('mouseleave', () => {
      bar.style.width = '0';
      tc.textContent = '00:00:00';
      frame.style.backgroundPosition = '20% 30%';
    });

    tile.addEventListener('mousemove', (e) => {
      const r = tile.getBoundingClientRect();
      const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
      frame.style.backgroundPosition = `${20 + x * 60}% ${30 + x * 20}%`;
      bar.style.width = `${x * 100}%`;

      const totalFrames = Math.floor(x * NOMINAL_SECONDS * FPS);
      const s = Math.floor(totalFrames / FPS) % 60;
      const f = totalFrames % FPS;
      tc.textContent = `00:00:${String(s).padStart(2, '0')}:${String(f).padStart(2, '0')}`;
    });
  });
</script>
