---
interface Props {
  /** Кадр-превью — что показывается до нажатия плей */
  poster: string;
  /** Ссылка на встраиваемый плеер. Если не указана — плея нет, только скраб по кадру */
  embed?: string;
  /** Подпись под плеером — используется в списке нескольких роликов */
  label?: string;
  /** Крупный герой страницы или компактный блок в списке роликов */
  size?: 'hero' | 'clip';
}

const { poster, embed, label, size = 'hero' } = Astro.props;
---

<figure class={`scrubplayer ${size}`}>
  <div class="scrubplayer-media">
    <div class="scrubplayer-frame" style={`background-image:url('${poster}')`}></div>
    <div class="scrubplayer-veil"></div>
    {
      embed && (
        <button class="scrubplayer-play" aria-label="Play" data-embed={embed}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      )
    }
    <div class="scrubplayer-scrubwrap">
      <div class="scrubplayer-bar"></div>
      <div class="scrubplayer-tc mono">00:00:00</div>
    </div>
  </div>
  {label && <figcaption class="scrubplayer-label mono">{label}</figcaption>}
</figure>

<script>
  // Тот же приём, что на плитках главной: скраб по кадру, таймкод 24 fps.
  // Плюс кнопка плей — по клику кадр меняется на встроенный видеоплеер.
  const FPS = 24;
  const FRAME_MS = 1000 / FPS;

  document.querySelectorAll<HTMLElement>('.scrubplayer').forEach((player) => {
    const media = player.querySelector<HTMLElement>('.scrubplayer-media');
    const frame = player.querySelector<HTMLElement>('.scrubplayer-frame');
    const bar = player.querySelector<HTMLElement>('.scrubplayer-bar');
    const tc = player.querySelector<HTMLElement>('.scrubplayer-tc');
    const playBtn = player.querySelector<HTMLButtonElement>('.scrubplayer-play');
    if (!media || !frame || !bar || !tc) return;

    let raf: number | null = null;
    let start = 0;
    let playing = false;

    const tick = () => {
      const ms = performance.now() - start;
      const f = Math.floor(ms / FRAME_MS) % FPS;
      const s = Math.floor(ms / 1000) % 60;
      tc.textContent = `00:00:${String(s).padStart(2, '0')}:${String(f).padStart(2, '0')}`;
      raf = requestAnimationFrame(tick);
    };

    media.addEventListener('mouseenter', () => {
      if (playing) return;
      start = performance.now();
      tick();
    });

    media.addEventListener('mouseleave', () => {
      if (playing || raf === null) return;
      cancelAnimationFrame(raf);
      raf = null;
      bar.style.width = '0';
      tc.textContent = '00:00:00';
      frame.style.backgroundPosition = '20% 30%';
    });

    media.addEventListener('mousemove', (e) => {
      if (playing) return;
      const r = media.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      frame.style.backgroundPosition = `${20 + x * 60}% ${30 + x * 20}%`;
      bar.style.width = `${x * 100}%`;
    });

    playBtn?.addEventListener('click', () => {
      const embedUrl = playBtn.dataset.embed;
      if (!embedUrl || playing) return;
      playing = true;
      if (raf !== null) cancelAnimationFrame(raf);

      const iframe = document.createElement('iframe');
      iframe.className = 'scrubplayer-iframe';
      iframe.src = embedUrl;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      media.replaceChildren(iframe);
    });
  });
</script>
