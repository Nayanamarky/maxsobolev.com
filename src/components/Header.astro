---
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Путь текущей страницы без языкового префикса — чтобы переключатель языка вёл на ту же страницу */
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const t = useTranslations(locale);
const name = locale === 'ru' ? 'МАКСИМ СОБОЛЕВ' : 'MAX SOBOLEV';
---

<header>
  <a class="brand" href={localePath(locale, '/')}>
    <div class="name">{name}</div>
    <div class="role mono">{t('brand.role')}</div>
  </a>

  <div class="menuzone">
    <button class="burger" id="burger" aria-label={t('menu.label')} aria-expanded="false" aria-controls="dropdown">
      <span></span><span></span><span></span>
    </button>

    <div class="dropdown" id="dropdown">
      {/* латинская подпись — приём из прототипа; на английской версии она дублировала бы пункт */}
      <a href={localePath(locale, '/about')}>
        {t('menu.about')}{locale === 'ru' && <span class="en mono">ABOUT</span>}
      </a>
      <a href={localePath(locale, '/contact')}>
        {t('menu.contact')}{locale === 'ru' && <span class="en mono">CONTACT</span>}
      </a>
      <a href={localePath(locale, '/posts')}>
        {t('menu.posts')}<span class="en mono">TELEGRAM</span>
      </a>
      <div class="sep"></div>
      <div class="lang mono">
        <a href={localePath('ru', path)} aria-current={locale === 'ru' ? 'true' : undefined}>RU</a>
        <a href={localePath('en', path)} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
      </div>
      <div class="foot mono">TELEGRAM · BEHANCE · IMDB</div>
    </div>
  </div>
</header>

<script>
  const dd = document.getElementById('dropdown');
  const bg = document.getElementById('burger');

  if (dd && bg) {
    const toggle = (open: boolean) => {
      dd.classList.toggle('open', open);
      bg.classList.toggle('open', open);
      bg.setAttribute('aria-expanded', String(open));
    };

    bg.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle(!dd.classList.contains('open'));
    });
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) toggle(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>
