---
import { useTranslations, type Locale } from '../i18n/ui';

interface Video {
  label?: { ru: string; en: string };
  embed: string;
  poster?: string;
}

interface Props {
  locale: Locale;
  /** Ролики проекта. Пустой массив/не задано — герой просто кадр без плея */
  videos?: Video[];
  /** Обложка проекта — запасной кадр, если у ролика нет своего poster */
  cover: string;
}

const { locale, videos = [], cover } = Astro.props;
const t = useTranslations(locale);
const [first] = videos;
---

<figure class="scrubplayer hero" id="videohero">
  <div class="scrubplayer-media">
    <div class="scrubplayer-frame" style={`background-image:url('${first?.poster ?? cover}')`}></div>
    <div class="scrubplayer-veil"></div>
    {
      first?.embed && (
        <button class="scrubplayer-play" aria-label="Play">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      )
    }
    <div class="scrubplayer-scrubwrap">
      <div class="scrubplayer-bar"></div>
    </div>
  </div>
</figure>

{
  videos.length > 1 && (
    <div class="videothumbs mono" id="videothumbs">
      {videos.map((v, i) => (
        <button class={i === 0 ? 'active' : undefined} data-embed={v.embed} data-poster={v.poster ?? cover}>
          {v.label?.[locale] ?? `${t('project.clip')} ${i + 1}`}
        </button>
      ))}
    </div>
  )
}

<script>
  // Герой умеет показывать несколько роликов по очереди: клик по миниатюре снизу
  // подменяет ролик в этом же плеере и сразу запускает воспроизведение — отдельная
  // страница на каждый ролик тут не нужна, все ролики одного проекта смотрятся
  // в одном месте.
  //
  // Полоса — от позиции курсора, чисто декоративный UI-мотив (не привязана
  // к реальному видео). Таймкода нет — убрали, был фейковым. Панорамы кадра
  // тоже нет — вернутся оба, когда появится настоящий скраб через
  // video.currentTime. См. «Задачи разработки/01_concept.md».

  const hero = document.getElementById('videohero');
  const media = hero?.querySelector<HTMLElement>('.scrubplayer-media');

  if (hero && media) {
    const bindIdle = () => {
      const bar = media.querySelector<HTMLElement>('.scrubplayer-bar');
      const playBtn = media.querySelector<HTMLButtonElement>('.scrubplayer-play');

      if (bar) {
        media.onmouseleave = () => {
          bar.style.width = '0';
        };
        media.onmousemove = (e) => {
          const r = media.getBoundingClientRect();
          const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
          bar.style.width = `${x * 100}%`;
        };
      }

      playBtn?.addEventListener('click', () => {
        if (playBtn.dataset.embed) renderPlaying(playBtn.dataset.embed);
      });
    };

    const renderPlaying = (embedUrl: string) => {
      media.onmouseleave = null;
      media.onmousemove = null;
      const isDirectFile = /\.(mp4|webm|mov|m3u8)(\?|$)/i.test(embedUrl);
      if (isDirectFile) {
        media.innerHTML = `<video class="scrubplayer-video" src="${embedUrl}" controls autoplay></video>`;
      } else {
        media.innerHTML = `<iframe class="scrubplayer-iframe" src="${embedUrl}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
      }
    };

    bindIdle();

    document.querySelectorAll<HTMLButtonElement>('#videothumbs button').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#videothumbs button').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const embedUrl = btn.dataset.embed;
        if (embedUrl) renderPlaying(embedUrl);
      });
    });
  }
</script>
