---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Один плоский ряд тегов, выбор одиночный: тип работы и производство —
// разные оси данных на проекте, но в фильтре это просто теги вперемешку,
// активен всегда только один.
const filters = [
  { key: 'all', axis: 'type', label: t('filter.all') },
  { key: 'character', axis: 'type', label: t('filter.character') },
  { key: 'vfx', axis: 'type', label: t('filter.vfx') },
  { key: 'motion2d', axis: 'type', label: t('filter.motion2d') },
  { key: 'neuro', axis: 'type', label: t('filter.neuro') },
  { key: 'shoot', axis: 'prod', label: t('production.shoot') },
  { key: 'cg', axis: 'prod', label: t('production.cg') },
];
---

<div class="filters" id="filters">
  {
    filters.map((f) => (
      <button class={f.key === 'all' ? 'active' : undefined} data-axis={f.axis} data-f={f.key}>
        {f.label}
      </button>
    ))
  }
</div>

<script>
  const filters = document.getElementById('filters');

  filters?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;

    filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
    b.classList.add('active');

    const axis = b.dataset.axis;
    const f = b.dataset.f;

    document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
      if (f === 'all') {
        tile.classList.remove('hidden');
        return;
      }
      const match =
        axis === 'prod' ? (tile.dataset.prod ?? '') === f : (tile.dataset.cat ?? '').split(' ').includes(f!);
      tile.classList.toggle('hidden', !match);
    });
  });
</script>
