---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Один плоский ряд тегов категорий, выбор одиночный.
const filters = [
  { key: 'all', label: t('filter.all') },
  { key: 'character', label: t('filter.character') },
  { key: 'cg', label: t('filter.cg') },
  { key: 'vfx', label: t('filter.vfx') },
  { key: 'motion2d', label: t('filter.motion2d') },
  { key: 'neuro', label: t('filter.neuro') },
];
---

<div class="filters" id="filters">
  {
    filters.map((f) => (
      <button class={f.key === 'all' ? 'active' : undefined} data-f={f.key}>
        {f.label}
      </button>
    ))
  }
</div>

<script>
  const filters = document.getElementById('filters');

  function activate(target: HTMLElement) {
    if (!filters) return;
    filters.querySelectorAll('button').forEach((x) => x.classList.remove('active'));
    target.classList.add('active');

    const f = target.dataset.f;

    document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
      if (f === 'all') {
        tile.classList.remove('hidden');
        return;
      }
      const match = (tile.dataset.cat ?? '').split(' ').includes(f!);
      tile.classList.toggle('hidden', !match);
    });
  }

  filters?.addEventListener('click', (e) => {
    const clicked = (e.target as HTMLElement).closest('button');
    if (!clicked) return;

    // Повторный клик по уже активному тегу снимает фильтр — возвращает «ВСЕ».
    const wasActive = clicked.classList.contains('active');
    const target = wasActive && clicked.dataset.f !== 'all' ? filters.querySelector<HTMLElement>('[data-f="all"]')! : clicked;
    activate(target);
  });

  // Подхватить фильтр из ссылки (?f=vfx) — так сюда ведут кликабельные теги
  // на странице проекта.
  const urlFilter = new URLSearchParams(location.search).get('f');
  const urlBtn = urlFilter && filters?.querySelector<HTMLElement>(`[data-f="${urlFilter}"]`);
  if (urlBtn) activate(urlBtn);
</script>
